{
  "name": "tf2-voice-emulator",
  "version": "4.8.0",
  "private": true,
  "description": "Plays any sound the way a Team Fortress 2 player's voice reaches another player, in the browser: Steam's sender, the game's codecs and its receiver, as read from the game's files and checked against recordings.",
  "scripts": {
    "dev": "node tests/static-server.js",
    "test": "node tests/run.mjs",
    "test:all": "node tests/run.mjs all",
    "test:browser": "node tests/run.mjs browser",
    "test:vendor": "node tests/run.mjs vendor",
    "build:opus11": "node tests/libopus11/build.mjs",
    "build:lame": "node tests/lame/build.mjs",
    "build:celt": "node tests/celt011/build.mjs",
    "build:speex": "node tests/speex102/build.mjs",
    "build:vr12": "node tests/vr12/build.mjs",
    "vendor:opus": "node tests/vendor-opus.mjs",
    "accuracy": "node tests/accuracy.mjs",
    "analyze:reference": "node tests/reference.analyze.mjs",
    "compare:reference": "node tests/reference.compare.mjs --compact",
    "demo:extract": "node tests/demovoice/extract.mjs"
  },
  "devDependencies": {
    "libopus-wasm": "0.4.0",
    "mpg123-decoder": "0.4.8",
    "playwright": "1.61.1"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  }
}
